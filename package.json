{
  "name": "vscode-ai-code-review",
  "displayName": "AI Code Review Agent",
  "description": "AI-powered code review agent using Vercel AI SDK. Bring your own provider.",
  "version": "0.1.0",
  "publisher": "ai-code-review",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "ai",
    "code review",
    "openai",
    "anthropic",
    "gemini",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/squall-chua/vscode-ai-code-review.git"
  },
  "icon": "resources/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiReview.reviewGitDiff",
        "title": "AI Review: Git Changes...",
        "icon": "$(play-circle)"
      },
      {
        "command": "aiReview.reviewGitFile",
        "title": "Review This File"
      },
      {
        "command": "aiReview.reviewGitGroup",
        "title": "Review All Files",
        "icon": "$(play)"
      },
      {
        "command": "aiReview.reviewFile",
        "title": "AI Review: Review Active File",
        "icon": "$(search)"
      },
      {
        "command": "aiReview.reviewSelection",
        "title": "AI Review: Review Selection",
        "icon": "$(selection)"
      },
      {
        "command": "aiReview.reviewSelectedFiles",
        "title": "AI Review: Review Selected Items",
        "icon": "$(files)"
      },
      {
        "command": "aiReview.manageProfiles",
        "title": "AI Review: Manage Profiles",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aiReview.switchProfile",
        "title": "AI Review: Switch Profile",
        "icon": "$(account)"
      },
      {
        "command": "aiReview.copyFixPrompt",
        "title": "AI Review: Copy Fix Prompt",
        "icon": "$(copy)"
      },
      {
        "command": "aiReview.suppressIssue",
        "title": "AI Review: Suppress Issue",
        "icon": "$(mute)"
      },
      {
        "command": "aiReview.manageSuppressed",
        "title": "AI Review: Manage Suppressed Issues",
        "icon": "$(list-unordered)"
      },
      {
        "command": "aiReview.clearDecorations",
        "title": "AI Review: Clear Inline Annotations",
        "icon": "$(clear-all)"
      },
      {
        "command": "aiReview.sidebar.goToIssue",
        "title": "AI Review: Go to Issue",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aiReview.sidebar.clearIssues",
        "title": "AI Review: Clear Issues",
        "icon": "$(trash)"
      },
      {
        "command": "aiReview.sidebar.refreshTree",
        "title": "AI Review: Refresh Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "aiReview.sidebar.saveReviewSummary",
        "title": "Save Review Summary...",
        "icon": "$(save)"
      },
      {
        "command": "aiReview.sidebar.deleteHistoryEntry",
        "title": "Delete Review History Entry",
        "icon": "$(trash)"
      },
      {
        "command": "aiReview.sidebar.reapplyFileDecorations",
        "title": "Re-apply Annotations",
        "icon": "$(check-all)"
      },
      {
        "command": "aiReview.sidebar.clearFileDecorations",
        "title": "Clear Annotations",
        "icon": "$(clear-all)"
      },
      {
        "command": "aiReview.openSettings",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aiReview.sidebar.unsuppress",
        "title": "Unsuppress Issue",
        "icon": "$(eye)"
      },
      {
        "command": "aiReview.sidebar.toggleGrouping",
        "title": "Toggle Grouping (By File/Severity)",
        "icon": "$(list-flat)"
      },
      {
        "command": "aiReview.sidebar.clearSuppressed",
        "title": "Clear All Suppressed Issues",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiReviewSidebar",
          "title": "AI Code Review",
          "icon": "resources/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "aiReviewSidebar": [
        {
          "id": "aiReview.issuesTree",
          "name": "Issues",
          "icon": "$(warning)"
        },
        {
          "id": "aiReview.gitChanges",
          "name": "Git Changes",
          "icon": "$(git-branch)"
        },
        {
          "id": "aiReview.suppressedTree",
          "name": "Suppressed Issues",
          "icon": "$(mute)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiReview.sidebar.toggleGrouping",
          "when": "view == aiReview.issuesTree",
          "group": "navigation@1"
        },
        {
          "command": "aiReview.reviewGitDiff",
          "when": "view == aiReview.issuesTree",
          "group": "navigation@1"
        },
        {
          "command": "aiReview.reviewFile",
          "when": "view == aiReview.issuesTree",
          "group": "navigation@2"
        },
        {
          "command": "aiReview.reviewSelection",
          "when": "view == aiReview.issuesTree && editorHasSelection",
          "group": "navigation@3"
        },
        {
          "command": "aiReview.sidebar.clearIssues",
          "when": "view == aiReview.issuesTree",
          "group": "navigation@4"
        },
        {
          "command": "aiReview.sidebar.refreshTree",
          "when": "view == aiReview.issuesTree",
          "group": "navigation@5"
        },
        {
          "command": "aiReview.openSettings",
          "when": "view == aiReview.issuesTree",
          "group": "navigation@6"
        },
        {
          "command": "aiReview.sidebar.refreshTree",
          "when": "view == aiReview.gitChanges",
          "group": "navigation@1"
        },
        {
          "command": "aiReview.reviewGitDiff",
          "when": "view == aiReview.gitChanges",
          "group": "navigation@2"
        },
        {
          "command": "aiReview.sidebar.clearSuppressed",
          "when": "view == aiReview.suppressedTree",
          "group": "navigation@1"
        },
        {
          "command": "aiReview.sidebar.refreshTree",
          "when": "view == aiReview.suppressedTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "aiReview.reviewGitFile",
          "when": "viewItem == gitFileChange",
          "group": "1_actions@1"
        },
        {
          "command": "aiReview.reviewGitFile",
          "when": "viewItem == gitFileChange",
          "group": "inline"
        },
        {
          "command": "aiReview.reviewGitGroup",
          "when": "viewItem =~ /gitGroup_/",
          "group": "1_actions@2"
        },
        {
          "command": "aiReview.reviewGitGroup",
          "when": "viewItem =~ /gitGroup_/",
          "group": "inline"
        },
        {
          "command": "aiReview.suppressIssue",
          "when": "view == aiReview.issuesTree && (viewItem == issue || viewItem == issueFile || viewItem == reviewHistory || viewItem == severityGroup)",
          "group": "1_actions"
        },
        {
          "command": "aiReview.copyFixPrompt",
          "when": "view == aiReview.issuesTree && (viewItem == issue || viewItem == issueFile || viewItem == reviewHistory || viewItem == severityGroup)",
          "group": "1_actions"
        },
        {
          "command": "aiReview.sidebar.saveReviewSummary",
          "when": "view == aiReview.issuesTree && viewItem == reviewHistory",
          "group": "2_history"
        },
        {
          "command": "aiReview.sidebar.deleteHistoryEntry",
          "when": "view == aiReview.issuesTree && viewItem == reviewHistory",
          "group": "2_history"
        },
        {
          "command": "aiReview.sidebar.reapplyFileDecorations",
          "when": "view == aiReview.issuesTree && viewItem == issueFile",
          "group": "1_actions",
          "icon": "$(check-all)"
        },
        {
          "command": "aiReview.sidebar.reapplyFileDecorations",
          "when": "view == aiReview.issuesTree && viewItem == issueFile",
          "group": "inline"
        },
        {
          "command": "aiReview.sidebar.clearFileDecorations",
          "when": "view == aiReview.issuesTree && viewItem == issueFile",
          "group": "1_actions",
          "icon": "$(clear-all)"
        },
        {
          "command": "aiReview.sidebar.clearFileDecorations",
          "when": "view == aiReview.issuesTree && viewItem == issueFile",
          "group": "inline"
        },
        {
          "command": "aiReview.sidebar.unsuppress",
          "when": "view == aiReview.suppressedTree && (viewItem == suppressedIssue || viewItem == suppressionScope || viewItem == suppressedFileGroup)",
          "group": "1_actions",
          "icon": "$(eye)"
        },
        {
          "command": "aiReview.sidebar.unsuppress",
          "when": "view == aiReview.suppressedTree && (viewItem == suppressedIssue || viewItem == suppressionScope || viewItem == suppressedFileGroup)",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "aiReview.reviewGitDiff"
        },
        {
          "command": "aiReview.reviewFile"
        },
        {
          "command": "aiReview.reviewSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "aiReview.reviewSelectedFiles"
        },
        {
          "command": "aiReview.manageProfiles"
        },
        {
          "command": "aiReview.switchProfile"
        },
        {
          "command": "aiReview.manageSuppressed"
        },
        {
          "command": "aiReview.clearDecorations"
        },
        {
          "command": "aiReview.sidebar.goToIssue",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.clearIssues",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.refreshTree",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.saveReviewSummary",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.deleteHistoryEntry",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.reapplyFileDecorations",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.clearFileDecorations",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.unsuppress",
          "when": "false"
        },
        {
          "command": "aiReview.sidebar.clearSuppressed",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "aiReview.reviewFile",
          "group": "aiReview@1",
          "when": "editorTextFocus"
        },
        {
          "command": "aiReview.reviewSelection",
          "group": "aiReview@2",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "aiReview.reviewSelectedFiles",
          "group": "aiReview@1"
        }
      ],
      "scm/title": [
        {
          "command": "aiReview.reviewGitDiff",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiReview.reviewFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus"
      },
      {
        "command": "aiReview.reviewGitDiff",
        "key": "ctrl+shift+g r",
        "mac": "cmd+shift+g r"
      }
    ],
    "configuration": {
      "title": "AI Code Review",
      "properties": {
        "aiReview.activeProfile": {
          "type": "string",
          "default": "",
          "description": "The name of the active AI provider profile to use for code reviews."
        },
        "aiReview.maxContextFiles": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of related files the AI agent can read for additional context during review.",
          "minimum": 0,
          "maximum": 20
        },
        "aiReview.suppressionScope": {
          "type": "string",
          "enum": [
            "file",
            "workspace",
            "global"
          ],
          "default": "workspace",
          "description": "Default scope for suppressing review issues."
        },
        "aiReview.enableContextExpansion": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic context expansion (reading related files) during code review."
        },
        "aiReview.maxFilesPerReview": {
          "type": "number",
          "default": 30,
          "description": "Maximum number of files allowed in a single recursive or multi-item review session.",
          "minimum": 1,
          "maximum": 100
        },
        "aiReview.maxOutputTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens allowed in the AI response. Increase this for more detailed reviews on larger files.",
          "minimum": 256,
          "maximum": 32768
        },
        "aiReview.temperature": {
          "type": "number",
          "default": 0.1,
          "description": "Temperature for the AI response. Lower is more predictable and consistent, higher is more creative.",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "node ./out/test/runTest.js",
    "pretest": "tsc -p tsconfig.test.json",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.82",
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/azure": "^3.0.49",
    "@ai-sdk/cerebras": "^2.0.26",
    "@ai-sdk/cohere": "^3.0.27",
    "@ai-sdk/deepinfra": "^2.0.41",
    "@ai-sdk/deepseek": "^2.0.26",
    "@ai-sdk/fireworks": "^2.0.42",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/google-vertex": "^4.0.95",
    "@ai-sdk/groq": "^3.0.31",
    "@ai-sdk/mistral": "^3.0.27",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/perplexity": "^3.0.26",
    "@ai-sdk/togetherai": "^2.0.41",
    "@ai-sdk/xai": "^3.0.74",
    "@friendliai/ai-provider": "^1.1.8",
    "@langdb/vercel-provider": "^0.1.1",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@portkey-ai/vercel-provider": "^2.1.0",
    "ai": "^6.0.0",
    "ai-sdk-provider-claude-code": "^3.4.4",
    "ai-sdk-provider-codex-cli": "^1.1.0",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "ai-sdk-provider-opencode-sdk": "^3.0.0",
    "anthropic-vertex-ai": "^1.0.2",
    "highlight.js": "^11.11.1",
    "marked": "^4.3.0",
    "marked-highlight": "^2.2.3",
    "ollama-ai-provider": "^1.2.0",
    "sarvam-ai-provider": "^1.0.2",
    "spark-ai-provider": "^0.1.2",
    "zhipu-ai-provider": "^0.2.2",
    "zod": "^4.3.6"
  }
}
